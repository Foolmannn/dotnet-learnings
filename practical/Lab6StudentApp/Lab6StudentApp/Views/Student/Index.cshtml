@model IEnumerable<Lab6StudentApp.Models.Student>

<h2>Student List</h2>

<a asp-action="Create">Add Student</a>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Address</th>
        <th>Actions</th>
    </tr>

    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.Department</td>
            <td>@student.Address</td>
            <td>
                <a asp-action="Edit"
                   asp-route-id="@student.Id">Edit</a>

                <a asp-action="Delete"
                   asp-route-id="@student.Id">Delete</a>
            </td>
        </tr>
    }
</table>
